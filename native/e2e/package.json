{
  "name": "demo-shop-native-e2e",
  "private": true,
  "type": "module",
  "imports": {
    "#screen_objects/*": "./tests/screen_objects/*",
    "#helpers/*": "./tests/helpers/*",
    "#data/*": "./tests/data/*",
    "#support/*": "./tests/support/*"
  },
  "scripts": {
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:ios:exercises": "wdio run ./config/wdio.ios.conf.ts --spec ./tests/specs/99-exercises.spec.ts",
    "test:android:exercises": "wdio run ./config/wdio.android.conf.ts --spec ./tests/specs/99-exercises.spec.ts",
    "test:ios:solutions": "wdio run ./config/wdio.ios.conf.ts --spec ./solutions/99-exercises.solutions.spec.ts",
    "test:android:solutions": "wdio run ./config/wdio.android.conf.ts --spec ./solutions/99-exercises.solutions.spec.ts",
    "inspector": "appium --allow-cors",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "3.5.2",
    "typescript": "^5.9.3"
  }
}
